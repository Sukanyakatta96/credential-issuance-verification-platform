# Copy to .env and replace every value marked CHANGE_ME. Never commit .env.
DATABASE_PATH=instance/credentials.db
DATA_DIR=data/full
GROUND_TRUTH_DIR=data/full/ground_truth

# Secret used to sign login tokens (use 32+ random characters).
JWT_SECRET=CHANGE_ME_generate_with_python_-c_"import secrets;print(secrets.token_urlsafe(48))"
JWT_TTL_MINUTES=480

# Master secret from which issuer Ed25519 signing keys are derived.
# The data generator and the application MUST use the same value.
SIGNING_MASTER_SECRET=CHANGE_ME_generate_with_python_-c_"import secrets;print(secrets.token_urlsafe(48))"

# Public verification throttle: requests per minute per client IP.
PUBLIC_RATE_LIMIT_PER_MINUTE=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300
HOST=127.0.0.1
PORT=5000
