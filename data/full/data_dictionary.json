        ],
        "unit": null,
        "unique": false,
        "rule": "null iff not_found"
      },
      {
        "name": "processed_by",
        "type": "string",
        "required": false,
        "allowed": null,
        "unit": null,
        "unique": false,
        "rule": ""
      }
    ]
  },
