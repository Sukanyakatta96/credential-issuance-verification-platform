        "name": "channel",
        "type": "string",
        "required": true,
        "allowed": [
          "public_api",
          "support_desk",
          "learner_share"
        ],
        "unit": null,
        "unique": false,
        "rule": ""
      },
      {
        "name": "requester_type",
        "type": "string",
        "required": true,
        "allowed": [
          "employer",
          "institution",
          "learner",
          "support",
          "other"
        ],
        "unit": null,
        "unique": false,
        "rule": ""
      },
      {
        "name": "requester_org",
        "type": "string",
        "required": false,
        "allowed": null,
        "unit": null,
        "unique": false,
        "rule": ""
      },
      {
        "name": "presented_hash",
        "type": "string",
        "required": false,
        "allowed": null,
        "unit": null,
        "unique": false,
        "rule": "64 hex chars when supplied"
      },
      {
        "name": "claimed_name",
        "type": "string",
        "required": false,
        "allowed": null,
        "unit": null,
        "unique": false,
        "rule": ""
      },
      {
        "name": "claimed_email",
        "type": "string",
        "required": false,
        "allowed": null,
        "unit": null,
        "unique": false,
        "rule": ""
      },
      {
        "name": "claimed_dob",
        "type": "date (YYYY-MM-DD)",
        "required": false,
        "allowed": null,
        "unit": null,
        "unique": false,
        "rule": ""
      },
      {
        "name": "result_status",
        "type": "string",
        "required": true,
        "allowed": [
          "valid",
          "revoked",
          "expired",
          "not_found",
          "tampered"
        ],
        "unit": null,
        "unique": false,
        "rule": "precedence: not_found > tampered > revoked > expired > valid"
      },
      {
        "name": "identity_status",
